# Local hosted Baton. Replace every secret before exposing these services.
NODE_ENV=development
DATABASE_URL=postgres://baton:baton@localhost:5432/baton
BATON_TOKEN_PEPPER=local-only-token-pepper-change-before-hosting-0001
BATON_COOKIE_SECRET=local-only-cookie-secret-change-before-hosting-0001
BATON_PUBLIC_API_URL=http://localhost:4000
BATON_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_BATON_API_URL=http://localhost:4000
BATON_API_URL=http://localhost:4000

# Optional CLI overrides. Baton stores only consent/checkpoint metadata locally.
# BATON_STATE_PATH=/absolute/path/to/installation-map.json
# BATON_CLAUDE_PROJECTS_DIR=/absolute/path/to/.claude/projects
# BATON_CODEX_SESSIONS_DIR=/absolute/path/to/.codex/sessions
# BATON_OPENCODE_DATABASE=/absolute/path/to/opencode.db

# A complete OIDC set is required in production. Local API tests inject a fake provider.
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth/authorize
# OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
# OIDC_USERINFO_ENDPOINT=https://identity.example.com/oauth/userinfo
# OIDC_CLIENT_ID=baton-local
# OIDC_CLIENT_SECRET=replace-me
