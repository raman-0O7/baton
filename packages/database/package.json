{
  "name": "@baton/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --enable-source-maps dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migration:check": "vitest run test/migrations.test.ts"
  },
  "dependencies": {
    "@baton/auth": "workspace:*",
    "@baton/indexing": "workspace:*",
    "@baton/memory": "workspace:*",
    "@baton/protocol": "workspace:*",
    "@baton/retrieval": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
